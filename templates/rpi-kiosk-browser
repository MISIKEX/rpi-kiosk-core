#!/usr/bin/env bash
set -Eeuo pipefail

readonly CONFIG_FILE="${RPI_KIOSK_CONFIG_FILE:-/etc/rpi-kiosk/browser.env}"
[[ -r "$CONFIG_FILE" ]] || {
  echo "Hiányzó konfiguráció: $CONFIG_FILE" >&2
  exit 1
}
# shellcheck disable=SC1090
source "$CONFIG_FILE"

valid_tcp_port() {
  local value="$1"
  [[ "$value" =~ ^[1-9][0-9]*$ ]] || return 1
  ((10#$value >= 1 && 10#$value <= 65535))
}

[[ "${NETWORK_WAIT_SECONDS:-}" =~ ^[1-9][0-9]*$ ]] || {
  echo "Hibás NETWORK_WAIT_SECONDS érték." >&2
  exit 2
}
[[ "${WORK_URL:-}" =~ ^https?://[^[:space:]]+$ ]] || {
  echo "Hibás WORK_URL érték." >&2
  exit 2
}
[[ "${IDLE_URL:-}" =~ ^https?://[^[:space:]]+$ ]] || {
  echo "Hibás IDLE_URL érték." >&2
  exit 2
}
for boolean_name in IDLE_ENABLED INCOGNITO_MODE WAIT_FOR_NETWORK; do
  boolean_value="${!boolean_name:-}"
  [[ "$boolean_value" == "y" || "$boolean_value" == "n" ]] || {
    echo "Hibás $boolean_name érték; csak y vagy n engedélyezett." >&2
    exit 2
  }
done
[[ -n "${CHROMIUM_BIN:-}" ]] || {
  echo "Hiányzó CHROMIUM_BIN érték." >&2
  exit 2
}
if [[ "$WAIT_FOR_NETWORK" == "y" && -z "${PING_HOST:-}" ]]; then
  echo "A WAIT_FOR_NETWORK=y beállításhoz PING_HOST szükséges." >&2
  exit 2
fi

WORK_DEBUG_PORT="${WORK_DEBUG_PORT:-9222}"
IDLE_DEBUG_PORT="${IDLE_DEBUG_PORT:-9223}"
valid_tcp_port "$WORK_DEBUG_PORT" || {
  echo "Hibás WORK_DEBUG_PORT; 1-65535 közötti TCP-port szükséges." >&2
  exit 2
}
valid_tcp_port "$IDLE_DEBUG_PORT" || {
  echo "Hibás IDLE_DEBUG_PORT; 1-65535 közötti TCP-port szükséges." >&2
  exit 2
}
[[ "$WORK_DEBUG_PORT" != "$IDLE_DEBUG_PORT" ]] || {
  echo "A WORK_DEBUG_PORT és IDLE_DEBUG_PORT nem lehet azonos." >&2
  exit 2
}

readonly RUNTIME_BASE="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
readonly RUNTIME_DIR="$RUNTIME_BASE/rpi-kiosk"
readonly STATE_FILE="$RUNTIME_DIR/browser-state"
readonly LOCK_FILE="$RUNTIME_DIR/browser.lock"
readonly PROFILE_BASE="${XDG_STATE_HOME:-$HOME/.local/state}/rpi-kiosk/chromium"
CONFIG_HASH="$(sha256sum "$CONFIG_FILE" | awk '{print $1}')"
readonly CONFIG_HASH

mkdir -p "$RUNTIME_DIR" "$PROFILE_BASE/work" "$PROFILE_BASE/idle"
chmod 0700 "$RUNTIME_DIR" "$PROFILE_BASE" "$PROFILE_BASE/work" "$PROFILE_BASE/idle"

exec 9>"$LOCK_FILE"
flock -w "$((NETWORK_WAIT_SECONDS + 20))" 9 || {
  echo "A böngészőváltó zárolása időtúllépés miatt sikertelen." >&2
  exit 1
}

requested_mode="${1:-work}"
force_restart="n"
if [[ "$requested_mode" == "force-restart" ]]; then
  force_restart="y"
  requested_mode="work"
  if [[ -r "$STATE_FILE" ]]; then
    saved_state="$(<"$STATE_FILE")"
    saved_mode="${saved_state%%:*}"
    [[ "$saved_mode" == "work" || "$saved_mode" == "idle" ]] && requested_mode="$saved_mode"
  fi
fi
readonly MODE="$requested_mode"

case "$MODE" in
  work) target_url="$WORK_URL"; opposite_mode="idle" ;;
  idle)
    [[ "$IDLE_ENABLED" == "y" ]] || exit 0
    target_url="$IDLE_URL"
    opposite_mode="work"
    ;;
  stop) target_url=""; opposite_mode="" ;;
  *)
    echo "Ismeretlen böngészőmód: $MODE" >&2
    exit 2
    ;;
esac

profile_dir() { printf '%s/%s\n' "$PROFILE_BASE" "$1"; }
pid_file() { printf '%s/browser-%s.pid\n' "$RUNTIME_DIR" "$1"; }
log_file() { printf '%s/chromium-%s.log\n' "$RUNTIME_DIR" "$1"; }
debug_port() {
  case "$1" in
    work) printf '%s\n' "$WORK_DEBUG_PORT" ;;
    idle) printf '%s\n' "$IDLE_DEBUG_PORT" ;;
    *) return 1 ;;
  esac
}

valid_managed_pid() {
  local mode="$1"
  local pid="$2"
  local profile
  profile="$(profile_dir "$mode")"
  [[ "$pid" =~ ^[1-9][0-9]*$ ]] || return 1
  kill -0 "$pid" 2>/dev/null || return 1
  [[ -r "/proc/$pid/cmdline" ]] || return 1
  tr '\0' ' ' <"/proc/$pid/cmdline" |
    grep -Fq -- "--user-data-dir=$profile"
}

current_pid() {
  local mode="$1"
  local file pid
  file="$(pid_file "$mode")"
  [[ -r "$file" ]] || return 1
  pid="$(<"$file")"
  valid_managed_pid "$mode" "$pid" || return 1
  printf '%s\n' "$pid"
}

stop_browser() {
  local mode="$1"
  local file pid attempt
  file="$(pid_file "$mode")"
  if ! pid="$(current_pid "$mode")"; then
    rm -f -- "$file"
    return 0
  fi

  kill -- "-$pid" 2>/dev/null || kill "$pid" 2>/dev/null || true
  for attempt in {1..30}; do
    kill -0 "$pid" 2>/dev/null || break
    sleep 0.1
  done
  if kill -0 "$pid" 2>/dev/null; then
    kill -KILL -- "-$pid" 2>/dev/null || kill -KILL "$pid" 2>/dev/null || true
  fi
  rm -f -- "$file"
}

wait_for_network() {
  [[ "$WAIT_FOR_NETWORK" == "y" ]] || return 0
  local attempt
  for ((attempt = 1; attempt <= NETWORK_WAIT_SECONDS; attempt++)); do
    if ping -c 1 -W 1 "$PING_HOST" >/dev/null 2>&1; then
      return 0
    fi
    sleep 1
  done
  echo "Figyelem: nincs hálózat ${NETWORK_WAIT_SECONDS} másodperc után; a Chromium elindul." >&2
}

launch_browser() {
  local mode="$1"
  local url="$2"
  local profile log pid_path browser_pid attempt port
  profile="$(profile_dir "$mode")"
  log="$(log_file "$mode")"
  pid_path="$(pid_file "$mode")"
  port="$(debug_port "$mode")"

  flags=(
    --kiosk
    --no-first-run
    --no-default-browser-check
    --noerrdialogs
    --disable-infobars
    --disable-session-crashed-bubble
    "--disable-features=Translate,TranslateUI"
    --autoplay-policy=no-user-gesture-required
    --enable-features=UseOzonePlatform
    --ozone-platform=wayland
    --password-store=basic
    --remote-debugging-address=127.0.0.1
    "--remote-debugging-port=$port"
    "--remote-allow-origins=*"
    "--user-data-dir=$profile"
  )
  [[ "$INCOGNITO_MODE" == "y" ]] && flags+=(--incognito)

  : >"$log"
  # A Chromium nem örökölheti a vezérlő zárolását: különben a következő
  # work/idle váltás a böngésző teljes élettartama alatt blokkolva marad.
  nohup setsid "$CHROMIUM_BIN" "${flags[@]}" "$url" >>"$log" 2>&1 9>&- &
  browser_pid=$!
  printf '%s\n' "$browser_pid" >"$pid_path"

  for attempt in {1..30}; do
    if valid_managed_pid "$mode" "$browser_pid"; then
      return 0
    fi
    kill -0 "$browser_pid" 2>/dev/null || break
    sleep 0.1
  done
  echo "A Chromium '$mode' példánya nem indult el. Napló: $log" >&2
  return 1
}

if [[ "$MODE" == "stop" ]]; then
  stop_browser work
  stop_browser idle
  rm -f -- "$STATE_FILE"
  exit 0
fi

expected_state="${MODE}:${CONFIG_HASH}"
if [[ "$force_restart" != "y" ]] &&
  [[ -r "$STATE_FILE" ]] &&
  [[ "$(<"$STATE_FILE")" == "$expected_state" ]] &&
  current_pid "$MODE" >/dev/null; then
  exit 0
fi

wait_for_network
if current_pid "$MODE" >/dev/null; then
  stop_browser "$MODE"
fi
launch_browser "$MODE" "$target_url"

# Normál work/idle váltásnál az új nézet előbb indul el. A két mód külön
# localhost DevTools portot használ, ezért az átfedés nem okoz portütközést.
sleep 0.8
stop_browser "$opposite_mode"
printf '%s\n' "$expected_state" >"$STATE_FILE"
